# Copy this file to .env (git-ignored) and fill it in. Never commit a real key.
#
# Talk to the Receptionist in your terminal:   npm run chat
#   The Receptionist greets first, you type, and replies stream as they are written.
#   Say goodbye to end the Call, or press Ctrl-C to quit.
#
# Hold a spoken Call in your terminal:   npm run talk
#   The same Call, with every reply also spoken aloud. Press Enter to record, speak, and press Enter again to stop,
#   or type a line instead. Needs the ElevenLabs variables below, macOS (replies are played with afplay), and ffmpeg
#   for the microphone (brew install ffmpeg). After each Turn a line says how long each phase of it took, in ms.
#
# Optional live checks of the real model and the real ElevenLabs Voice (they spend a little money):   npm run test:live
#   They need ANTHROPIC_API_KEY, ELEVENLABS_API_KEY and ELEVENLABS_VOICE_ID to pass. The Voice check plays nothing and
#   never opens the microphone.
# Plain `npm test` needs no key and no network.
#
# Get ready for a Call by phone:   bash scripts/telnyx-setup.sh
#   Then run the phone program with   npm run phone   (it listens on PORT behind your ngrok address and prints the webhook
#   address to paste into the Telnyx portal; Ctrl-C hangs up any Calls and stops). It has never been run against real Telnyx.
#   A wizard that walks you through the Telnyx account, the keys, ngrok, the Voice API application and the number, and
#   writes what it learns to .env. It buys nothing and starts nothing. The Telnyx variables are at the end of this file.

# Anthropic provider (required). The program stops at startup with a message if this is missing.
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs API key (required by `npm run talk` only). It pays for the Receptionist's Voice: speech out and speech in.
ELEVENLABS_API_KEY=

# Id of the ElevenLabs voice the Receptionist speaks with (required by `npm run talk` only). Copy it from the voice's
# page in your ElevenLabs account.
ELEVENLABS_VOICE_ID=

# Optional: ElevenLabs text-to-speech model. When empty, eleven_flash_v2_5 is used, which is a low-latency model.
ELEVENLABS_MODEL_ID=

# Optional: ElevenLabs speech-to-text model. When empty, scribe_v2 is used.
ELEVENLABS_STT_MODEL_ID=

# Optional: ElevenLabs API host, for a regional host. When empty, https://api.elevenlabs.io is used.
ELEVENLABS_BASE_URL=

# Not used yet: nothing reads this. It is for openrouter/<vendor>/<model> models on individual Nodes once an
# OpenRouter client exists.
OPENROUTER_API_KEY=

# Not used yet: nothing reads this. It is for the SQLite file once there is a database.
DB_PATH=./data/receptionist.db

# Optional: Flow file that `npm run chat` and `npm run talk` load at startup. A relative path is resolved from the
# directory you run it in. When unset, they load flows/receptionist.json from the project, wherever you run from.
FLOW_PATH=./flows/receptionist.json

# The variables below are for a Call by phone, over Telnyx, read by `npm run phone`. The setup wizard
# (bash scripts/telnyx-setup.sh) fills in the first four and reads the last three. `npm run phone` also needs
# ANTHROPIC_API_KEY, above, and stops at startup with one line per required variable that is missing.

# Telnyx API key (required for a Call by phone). It sends the commands that answer a call, speak and hang up.
TELNYX_API_KEY=

# The Telnyx account's public key, from the portal (required for a Call by phone). The signature on every webhook is
# checked with it.
TELNYX_PUBLIC_KEY=

# The public https:// address of this server (required for a Call by phone): the ngrok address, with nothing after the
# host. The wss:// address that Telnyx connects to is derived from it.
PUBLIC_BASE_URL=

# Optional: the phone numbers that may call, comma-separated, in E.164 form (such as +14155550100). When set, every
# other call is rejected unanswered. When empty, any Caller may call.
PHONE_ALLOWED_CALLERS=

# Optional: the Telnyx voice the Receptionist speaks with on the phone. When empty, Telnyx.Ultra.Callie is used.
TELNYX_TTS_VOICE=

# Optional: the speech recognition engine and its model. When empty, Deepgram and deepgram/nova-3 are used.
TELNYX_STT_ENGINE=
TELNYX_STT_MODEL=

# Optional: the language of a Call by phone. When empty, en is used.
VOICE_LANGUAGE=

# Optional: the port the server listens on, which ngrok forwards to. When empty, 3000 is used.
PORT=

# Optional: Telnyx API host, for a regional host. When empty, https://api.telnyx.com is used.
TELNYX_BASE_URL=

# Written by the setup wizard and read by nothing else: the Telnyx account level you told it (trial, paid, verified,
# ...). It decides whether Telnyx speaks its abuse notice before machine speech on a call.
TELNYX_ACCOUNT_LEVEL=
