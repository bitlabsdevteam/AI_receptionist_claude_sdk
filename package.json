{
  "name": "receptionist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI voice receptionist: a conversation-flow engine driven by a Flow defined as data.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "chat": "tsx src/adapters/cli.ts",
    "talk": "tsx src/adapters/talk-cli.ts",
    "test": "vitest run",
    "test:live": "RUN_LIVE=1 vitest run test/live.test.ts test/live-voice.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
