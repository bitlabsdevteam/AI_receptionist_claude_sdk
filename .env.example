# Copy this file to .env (git-ignored) and fill it in. Never commit a real key.
#
# Talk to the Receptionist in your terminal:   npm run chat
#   The Receptionist greets first, you type, and replies stream as they are written.
#   Say goodbye to end the Call, or press Ctrl-C to quit.
#
# Hold a spoken Call in your terminal:   npm run talk
#   The same Call, with every reply also spoken aloud. Press Enter to record, speak, and press Enter again to stop,
#   or type a line instead. Needs the ElevenLabs variables below, macOS (replies are played with afplay), and ffmpeg
#   for the microphone (brew install ffmpeg). After each Turn a line says how long each phase of it took, in ms.
#
# Optional live checks of the real model and the real ElevenLabs Voice (they spend a little money):   npm run test:live
#   They need ANTHROPIC_API_KEY, ELEVENLABS_API_KEY and ELEVENLABS_VOICE_ID to pass. The Voice check plays nothing and
#   never opens the microphone.
# Plain `npm test` needs no key and no network.

# Anthropic provider (required). The program stops at startup with a message if this is missing.
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs API key (required by `npm run talk` only). It pays for the Receptionist's Voice: speech out and speech in.
ELEVENLABS_API_KEY=

# Id of the ElevenLabs voice the Receptionist speaks with (required by `npm run talk` only). Copy it from the voice's
# page in your ElevenLabs account.
ELEVENLABS_VOICE_ID=

# Optional: ElevenLabs text-to-speech model. When empty, eleven_flash_v2_5 is used, which is a low-latency model.
ELEVENLABS_MODEL_ID=

# Optional: ElevenLabs speech-to-text model. When empty, scribe_v2 is used.
ELEVENLABS_STT_MODEL_ID=

# Optional: ElevenLabs API host, for a regional host. When empty, https://api.elevenlabs.io is used.
ELEVENLABS_BASE_URL=

# Not used yet: nothing reads this. It is for openrouter/<vendor>/<model> models on individual Nodes once an
# OpenRouter client exists.
OPENROUTER_API_KEY=

# Not used yet: nothing reads this. It is for the SQLite file once there is a database.
DB_PATH=./data/receptionist.db

# Optional: Flow file that `npm run chat` and `npm run talk` load at startup. A relative path is resolved from the
# directory you run it in. When unset, they load flows/receptionist.json from the project, wherever you run from.
FLOW_PATH=./flows/receptionist.json
