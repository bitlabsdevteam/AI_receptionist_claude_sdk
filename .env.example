# Copy this file to .env (git-ignored) and fill it in. Never commit a real key.
#
# Talk to the Receptionist in your terminal:   npm run chat
#   The Receptionist greets first, you type, and replies stream as they are written.
#   Say goodbye to end the Call, or press Ctrl-C to quit.
#
# Optional live check against the real model (spends a little money):   npm run test:live
# Plain `npm test` needs no key and no network.

# Anthropic provider (required). The program stops at startup with a message if this is missing.
ANTHROPIC_API_KEY=sk-ant-...

# Not used yet: nothing reads this. It is for openrouter/<vendor>/<model> models on individual Nodes once an
# OpenRouter client exists.
OPENROUTER_API_KEY=

# Not used yet: nothing reads this. It is for the SQLite file once there is a database.
DB_PATH=./data/receptionist.db

# Optional: Flow file that `npm run chat` loads at startup. A relative path is resolved from the directory you run it
# in. When unset, the CLI loads flows/receptionist.json from the project, wherever you run it from.
FLOW_PATH=./flows/receptionist.json
